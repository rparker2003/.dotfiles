# ============================================================
# Hyprland Overrides
# Omarchy defaults I intentionally override
# ============================================================

$scriptsDir = $HOME/.dotfiles/scripts


# ============================================================
# Window Navigation
# ============================================================

# Reserve SUPER + HJKL for Vim-style navigation
unbind = SUPER, H              # Toggle window split
unbind = SUPER, J              # Show key bindings
unbind = SUPER, K              # Toggle workspace layout
unbind = SUPER, L              # Reserved
unbind = SUPER SHIFT, H        # Reserved
unbind = SUPER SHIFT, J        # Reserved
unbind = SUPER SHIFT, K        # Reserved
unbind = SUPER SHIFT, L        # Reserved
unbind = SUPER, code:20        # Expand window left
unbind = SUPER, code:21        # Shrink window left
unbind = SUPER SHIFT, code:20  # Shrink window up
unbind = SUPER SHIFT, code:21  # Expand window down
unbind = SUPER, comma          # Reserved for resize
unbind = SUPER, period         # Reserved for resize
unbind = SUPER SHIFT, comma    # Reserved for resize
unbind = SUPER SHIFT, period   # Reserved for resize

# Focus windows
bind = SUPER, h, movefocus, l
bind = SUPER, j, movefocus, d
bind = SUPER, k, movefocus, u
bind = SUPER, l, movefocus, r

# Move windows
bind = SUPER SHIFT, h, movewindow, l
bind = SUPER SHIFT, j, movewindow, d
bind = SUPER SHIFT, k, movewindow, u
bind = SUPER SHIFT, l, movewindow, r

# Resize windows
binde = SUPER, comma, resizeactive, -100 0        # shrink left/right dimension
binde = SUPER, period, resizeactive, 100 0        # grow left/right dimension
binde = SUPER SHIFT, comma, resizeactive, 0 -100  # shrink vertically
binde = SUPER SHIFT, period, resizeactive, 0 100  # grow vertically


# ============================================================
# Productivity Scripts
# ============================================================

# Reserve SUPER + Z (Reserved)
unbind = SUPER, Z  # Reserved

# Jira + Zendesk search scripts
bind = SUPER SHIFT, J, exec, $scriptsDir/JiraSearch.sh
bind = SUPER SHIFT, Z, exec, $scriptsDir/ZendeskSearch.sh


# ============================================================
# Menus / Utilities
# ============================================================

# Reclaim SUPER + / from monitor scaling
unbind = SUPER, code:61
unbind = SUPER ALT, code:61

bindd = SUPER, SLASH, Show key bindings, exec, omarchy-menu-keybindings


# Switch tiling and file manager
unbind = SUPER SHIFT, F  # File manager
unbind = SUPER ALT SHIFT, F  # File manager (cwd)
unbind = SUPER, T  # Toggle window floating/tiling
bindd = SUPER SHIFT, F, Toggle window floating/tiling, togglefloating
bindd = SUPER, T, File manager, exec, uwsm-app -- nautilus --new-window
# bindd = SUPER ALT SHIFT, F, File manager (cwd), exec, uwsm-app -- nautilus --new-window "$(omarchy-cmd-terminal-cwd)"


# Re-bind kill to SUPER, Q
unbind = SUPER, W  # Close window
bindd = SUPER, Q, Close window, killactive


# Re-bind (OCR) screenshot to SUPER SHIFT, S (SUPER SHIFT CTRL, S)
unbind = , PRINT  # Screenshot
bindd = SUPER SHIFT, S, Screenshot, exec, omarchy-capture-screenshot
unbind = SUPER CTRL, PRINT  # Extract text (OCR) from screenshot
bindd = SUPER SHIFT CTRL, S, Extract text (OCR) from screenshot, exec, omarchy-capture-text-extraction


# Re-bind lock to ctrl+alt+l
unbind = SUPER CTRL, L  # Lock system
bindd = CTRL ALT, L, Lock system, exec, omarchy-system-lock


# Re-bind power menu to CTRL ALT, P
bindld = , XF86PowerOff, System menu, exec, omarchy-menu system
bindd = CTRL ALT, P, System menu, exec, omarchy-menu system
unbind = SUPER, ESCAPE  # System menu


# Re-bind wallpaper theme background menu to SUPER+w
unbind = SUPER CTRL, SPACE  # Theme background menu
bindd = SUPER, W, Theme background menu, exec, omarchy-menu background


# Re-bind omarchy menu to SUPER+esc
unbind = SUPER ALT, SPACE  # Omarchy menu
bindd = SUPER, ESCAPE, Omarchy menu, exec, omarchy-menu
